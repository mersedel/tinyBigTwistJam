  m_Script: {fileID: 11500000, guid: fc927ed7171926248838758b27b3aa2e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogTrigger
  dialog:
    chars:
    - character: 0
      definition: {fileID: 1831123486}
    - character: 1
      definition: {fileID: 1327252666}
    scenario:
    - character: 1
      phrase: Finaly! How much time did it take? I thought it would be my end...
    - character: 0
      phrase: Finaly what?
    - character: 1
      phrase: I dont realy know... I just now that its fine
    - character: 0
      phrase: ...whatever
    - character: 1
      phrase: By the way, the speed that you climbed thouse stairs was incredible.
        New iterations are insaine... but you still loose to me in some way... will
        you too?
    - character: 0
      phrase: Stop waste my time
    - character: 1
      phrase: Such a nostalgia... when i was 2 seconds younger i thought about time
        too...
